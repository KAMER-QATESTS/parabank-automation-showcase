    {
      "name": "02-Accounts",
      "item": [
        {
          "name": "02-Get Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\n\nconst accounts = pm.response.json();\n\npm.test(\"Response is an array with at least 2 accounts\", () => {\n  pm.expect(accounts).to.be.an(\"array\");\n  pm.expect(accounts.length).to.be.at.least(2);\n});\n\nif (accounts.length >= 2) {\n  pm.environment.set(\"fromAccountId\", accounts[0].id);\n  pm.environment.set(\"toAccountId\", accounts[1].id);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}",
                "accounts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Account Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\nconst account = pm.response.json();\npm.test(\"Account id matches\", () => pm.expect(String(account.id)).to.eql(String(pm.environment.get(\"fromAccountId\"))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{fromAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{fromAccountId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create  Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\nconst created = pm.response.json();\npm.test(\"New account has id\", () => pm.expect(created).to.have.property(\"id\"));\npm.environment.set(\"newAccountId\", created.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
