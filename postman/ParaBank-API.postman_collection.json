            "url": {
              "raw": "{{baseUrl}}/createAccount?customerId={{customerId}}&newAccountType=1&fromAccountId={{fromAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "createAccount"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                },
                {
                  "key": "newAccountType",
                  "value": "1"
                },
                {
                  "key": "fromAccountId",
                  "value": "{{fromAccountId}}"
                }
              ]
            }
          },
          "response": []
        },
