    {
      "name": "03-Transfer",
      "item": [
        {
          "name": "Get From Balance(Before)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\npm.environment.set(\"fromBalanceBefore\", pm.response.json().balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{fromAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{fromAccountId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get to Balance(Before)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"toBalanceBefore\", pm.response.json().balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{toAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{toAccountId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03-Transfer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const amount = Math.floor(Math.random() * 10) + 1;\npm.environment.set(\"transferAmount\", amount);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\n\npm.test(\"Response time under 3s\", () =>\n  pm.expect(pm.response.responseTime).to.be.below(3000));\n\nconst body = pm.response.text();\n\npm.test(\"Confirmation message mentions success\", () =>\n  pm.expect(body.toLowerCase()).to.include(\"success\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transfer?fromAccountId={{fromAccountId}}&toAccountId={{toAccountId}}&amount={{transferAmount}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transfer"
              ],
              "query": [
                {
                  "key": "fromAccountId",
                  "value": "{{fromAccountId}}"
                },
                {
                  "key": "toAccountId",
                  "value": "{{toAccountId}}"
                },
                {
                  "key": "amount",
                  "value": "{{transferAmount}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get From Balance(After)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\nconst before = Number(pm.environment.get(\"fromBalanceBefore\"));\nconst amount = Number(pm.environment.get(\"transferAmount\"));\nconst after = pm.response.json().balance;\npm.test(\"Source balance decreased by transfer amount\", () =>\n  pm.expect(after).to.be.closeTo(before - amount, 0.001));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{fromAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{fromAccountId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get To Balance (After)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Target balance increased\", () => {\n    let before = Number(pm.environment.get(\"toBalanceBefore\"));\n    let amount = Number(pm.environment.get(\"transferAmount\"));\n    let after = pm.response.json().balance;\n    pm.expect(after).to.be.closeTo(before + amount, 0.001);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{toAccountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{toAccountId}}"
              ],
              "query": [
                {
                  "key": "",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        }
      ]
